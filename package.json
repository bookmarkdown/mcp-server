{
  "name": "@bookmarkdown/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local BookMarkdown MCP server with a loopback WebSocket bridge",
  "type": "module",
  "bin": {
    "bookmarkdown-mcp-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "dev": "tsx src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "ws": "^8.18.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}