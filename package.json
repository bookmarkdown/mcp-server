{
  "name": "@bookmarkdown/mcp-server",
  "version": "0.2.0",
  "description": "Local BookMarkdown MCP server with a loopback WebSocket bridge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookmarkdown/mcp-server.git"
  },
  "homepage": "https://github.com/bookmarkdown/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/bookmarkdown/mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "browser",
    "chrome",
    "browser-automation"
  ],
  "type": "module",
  "bin": {
    "bookmarkdown-mcp-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-TW.md"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "os": [
    "win32",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node dist/cli.js",
    "dev": "tsx src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "ws": "^8.18.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
